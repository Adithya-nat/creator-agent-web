# Copy to .env.local and adjust. .env.local is gitignored.

# Base URL of the Creator Agent API (FastAPI). No trailing slash.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Where the "Creator Agent" link on the sign-in page goes (the GitHub Pages homepage).
NEXT_PUBLIC_HOMEPAGE_URL=https://adithya-nat.github.io/creator-agent/

# Cloudflare Turnstile site key (public). Leave blank to hide the widget in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Sign-in (hosted beta). Leave NEXT_PUBLIC_AUTH_ENABLED=false for local use. ---
# Must match the API's AUTH_MODE=jwt. Read at build time.
NEXT_PUBLIC_AUTH_ENABLED=false
# The public URL of this web app, e.g. https://app.example.com
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same Neon/Postgres database as the API. Better Auth uses its own schema (creator_auth).
DATABASE_URL=
# https://github.com/settings/developers -> OAuth Apps. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# https://console.cloud.google.com/apis/credentials. Redirect: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local testing only: sign up with email + password instead of OAuth. Never on a public server.
AUTH_EMAIL_PASSWORD=false
