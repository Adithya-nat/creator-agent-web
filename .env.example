# Copy to .env.local and adjust. .env.local is gitignored.

# Base URL of the storyboard_agent backend (FastAPI). No trailing slash.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Cloudflare Turnstile site key (public, safe to expose). Leave blank to hide the
# widget in local dev — the backend also skips verification unless TURNSTILE_ENABLED=true.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
